{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git config --get*)",
      "Bash(git config --local --get*)",
      "Bash(git add *)",
      "Bash(git restore --staged *)",
      "Bash(git commit -F *)",
      "Bash(git commit --file *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git remote -v*)",
      "Bash(git stash*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin docs/*)",
      "Bash(gh auth status*)",
      "Bash(gh auth token --user starpearl03*)",
      "Bash(gh repo view*)",
      "Bash(gh repo create starpearl03/felistas *)",
      "Bash(gh pr create *)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge * --squash *)",
      "Bash(gh pr close *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh api repos/starpearl03/felistas/*)",
      "Bash(gh api user*)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm view *)",
      "Bash(npx playwright *)",
      "Bash(npx vitest*)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push*--force-with-lease*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin :main*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push)",
      "Bash(git commit*--no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -d main*)",
      "Bash(git config core.hooksPath *)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh workflow disable*)",
      "Read(.env)",
      "Read(.env.local)"
    ]
  }
}
