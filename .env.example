# Copy to .env.local and fill in. Never commit real keys.

# Gemini (server only). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id with function calling. "gemini-flash-latest" tracks the current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Contact form email delivery via Resend (server only). https://resend.com
RESEND_API_KEY=
# Inbox that receives visitor messages
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Dusk <dusk@felistas.dev>". Before a domain is verified, Resend's test
# sender "Dusk <onboarding@resend.dev>" works, but it only delivers to the Resend account's own email.
CONTACT_FROM_EMAIL=

# Public site URL, used for metadata and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
