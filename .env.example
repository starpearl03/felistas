# Copy to .env.local and fill in. Never commit real keys.

# Gemini (server only). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model id with function calling. "gemini-flash-lite-latest" tracks the current Flash-Lite
# model: fast, the most generous free tier, and enough for short grounded answers. "gemini-flash-latest"
# is stronger but often overloaded on the free tier.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Email, through Resend (server only). https://resend.com ---
# When a visitor presses Send, two emails go out, both FROM CONTACT_FROM_EMAIL:
#   1. the visitor's message  -> TO CONTACT_TO_EMAIL (Felistas)  reply-to: the visitor
#   2. a confirmation receipt -> TO the visitor                  reply-to: CONTACT_TO_EMAIL
# All three variables are needed; without them the contact form says sending is unavailable.
RESEND_API_KEY=
# Felistas's own inbox, where visitor messages arrive
CONTACT_TO_EMAIL=felistas03charuka@gmail.com
# The sender of both emails. Its domain (felistas.co.zw) must be verified in Resend, or the
# confirmation can't reach visitors. Quote it here (the name has a space); in Vercel, quotes are
# optional (they are removed). A bad value is ignored with a warning, never failing the build.
CONTACT_FROM_EMAIL="Dusk <noreply@felistas.co.zw>"

# Resume PDF (optional). By default the site serves resume.source from content/profile.md
# (the starpearl03/resume repo); set this to serve a different https URL without a commit.
RESUME_URL=

# Google Search Console: the content of the HTML-tag verification method (optional)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the content of the <meta name="msvalidate.01"> tag (optional). Bing can also
# import the site from Search Console instead.
BING_SITE_VERIFICATION=

# Public site URL, used for metadata and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
